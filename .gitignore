# Aurelia Boutonnière — local SQLite convenience DB some contributors may
# create for quick testing (production uses the Dockerized MySQL in
# docker-compose.yml). storage/app/public/* already has its own nested
# .gitignore from the Laravel skeleton, so runtime-uploaded product
# photos/receipts/branding are excluded there, not here.
/database/database.sqlite

# Backup zips (App\Services\BackupService) and its scratch directory for
# in-progress restores — both are runtime data, never source.
/storage/app/backups

# Local dev MySQL compose file — kept untracked so each contributor can
# tune it for their own machine without touching version control.
/docker-compose.yml
/storage/app/tmp
